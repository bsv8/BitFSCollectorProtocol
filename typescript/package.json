{
  "name": "bitfs-collector-protocol",
  "version": "0.1.0",
  "description": "BitFS collector submission protocol SDK（采集提交：编码、gzip、签名、验签、HTTP 客户端）",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
